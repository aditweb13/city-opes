# FILE(2) — Backend Environment Variables
# Copy to .env and fill in your values

# Server
PORT=8000
ENV=development

# API Keys (optional - used for live data enrichment)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENROUTESERVICE_API_KEY=your_ors_key_here
WORLDPOP_BASE_URL=https://hub.worldpop.org/geodata

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# WandB (optional, for training tracking)
WANDB_API_KEY=your_wandb_key_here

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
